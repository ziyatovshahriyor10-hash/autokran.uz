generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model Sponsor {
  id           String   @id @default(uuid())
  name         String
  logoUrl      String
  websiteUrl   String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Crane {
  id          String   @id @default(uuid())
  modelName   String
  capacity    Float    // Lifting capacity in tons
  boomLength  Float    // Boom length in meters
  price       String   // Price string or float
  description String
  images      String[] // Array of image URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlobalSettings {
  id             String @id @default(uuid())
  phoneNumbers   String[]
  telegramBot    String?
  address        String?
  seoTitle       String?
  seoDescription String?
}
